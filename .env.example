# Microsoft Entra ID (Azure AD) Configuration Template
# Copy this file to .env and fill in your Azure App Registration secrets.
# DO NOT commit real secrets or credentials to Git.

# Azure Tenant & App Registration (Microsoft Entra ID)
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your_client_secret_value_here

# Enable strict authentication requirement (login required before accessing data)
AUTH_ENABLED=true

# Emergency (Onboarding) Admin User Credentials
# Used for initial system setup and onboarding the first Microsoft Entra ID Admin
EMERGENCY_ADMIN_USERNAME=emergency_admin
EMERGENCY_ADMIN_PASSWORD=your_secure_emergency_password_here

# Session / JWT Encryption Key
SECRET_KEY=mpp-hub-super-secret-key-change-in-production-2026

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Microsoft SQL Server (Granular parameters - recommended for passwords with special chars)
# MSSQL_HOST=192.168.1.50
# MSSQL_PORT=1433
# MSSQL_DATABASE=mpp_hub
# MSSQL_USER=sa
# MSSQL_PASSWORD=YourPasswordHere!
# MSSQL_TRUSTED_CONNECTION=false
# MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Option 2: Direct DATABASE_URL
# - Local dev (SQLite):
DATABASE_URL=sqlite:///./mpp_hub.db
# - Microsoft SQL Server (Pure Python / Docker, no external ODBC driver needed):
#   DATABASE_URL=mssql+pymssql://sa:YourPasswordHere@192.168.1.50:1433/mpp_hub
# - Microsoft SQL Server (ODBC Driver 18 / Windows Auth):
#   DATABASE_URL=mssql+pyodbc://sa:YourPasswordHere@192.168.1.50:1433/mpp_hub?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# - PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/mpp_hub
